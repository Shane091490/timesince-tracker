# Copy this file to .env and fill in real values before running docker compose.

# PostgreSQL
POSTGRES_DB=timesince
POSTGRES_USER=timesince
POSTGRES_PASSWORD=change_me_to_a_strong_password

# App
# Long random string used to sign login sessions. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# Set to true only if nginx is terminating HTTPS (recommended for production)
COOKIE_SECURE=false

# Port exposed on the host for nginx
HTTP_PORT=80
